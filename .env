# Environment for app
ENV=dev 
NGINX_PORT = 80
GATEWAY_PORT = 8080
AUTH_SERVICE_HOST=auth-service
AUTH_PORT = 8081
PRODUCT_SERVICE_HOST=product-service
PRODUCT_PORT = 8082
HTTP_TIMEOUT=20s

# PostgreSQL configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mypassword
POSTGRES_HOST=postgres  
POSTGRES_PORT=5432
POSTGRES_DB=techstore

# Redis configuration
REDIS_HOST=techstore_redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=10s